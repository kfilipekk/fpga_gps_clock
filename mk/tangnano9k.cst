//tang nano 9k (GW1NR-9C QN88), every top module uses these port names
IO_LOC  "clk" 52;  //27 mhz crystal
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

//buttons, active low
IO_LOC  "btn_s1" 4;
IO_PORT "btn_s1" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "btn_s2" 3;
IO_PORT "btn_s2" IO_TYPE=LVCMOS18 PULL_MODE=UP;

//leds, active low
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "led[2]" 13;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "led[3]" 14;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "led[4]" 15;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "led[5]" 16;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=UP;

//uart through the usb bridge
IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
